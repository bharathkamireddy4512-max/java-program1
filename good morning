class GoodMorning extends Thread {
    public void run() {
        while(true) {
            System.out.println("Good Morning");
            try {
                Thread.sleep(1000);
            } catch(Exception e) {}
        }
    }
}

class Hello extends Thread {
    public void run() {
        while(true) {
            System.out.println("Hello");
            try {
                Thread.sleep(2000);
            } catch(Exception e) {}
        }
    }
}

class Welcome extends Thread {
    public void run() {
        while(true) {
            System.out.println("Welcome");
            try {
                Thread.sleep(3000);
            } catch(Exception e) {}
        }
    }
}

class Main {
    public static void main(String args[]) {
        new GoodMorning().start();
        new Hello().start();
        new Welcome().start();
    }
}
